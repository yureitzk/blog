---
import Layout from '@components/layouts/Layout.astro';
import ProjectCard from '@components/partials/ProjectCard.astro';

import isaacFlashSaveEditorImage from '@assets/img/thumbnails/isaac-flash-save-editor.png';
import lodEndModeImage from '@assets/img/thumbnails/lowendmod-extension.png';
import humanFirstSearchImage from '@assets/img/thumbnails/human-first-search.png';
import pinpoint from '@assets/img/thumbnails/pinpoint.png';
import minecraftUsernameUuidGenerator from '@assets/img/thumbnails/minecraft-username-uuid-generator.png';
---

<Layout
	title='Projects'
	description='Just things I work/worked on.'
	class='space-y-7'
>
	<ProjectCard
		title={'LowEndMod'}
		description={'A browser extension that adds various enhancements and usability tweaks to the LowEndTalk forum.'}
		tags={['TypeScript', 'Browser Extension', 'Svelte']}
		link={'https://github.com/yureitzk/lowendmod'}
		img={lodEndModeImage}
	/>
	<ProjectCard
		title={'The Binding of Isaac Flash Save Editor'}
		description={'An editor for The Binding of Isaac (Flash version) `serial.txt` save file. Can be used as a library or through the CLI interface.'}
		tags={['TypeScript', 'CLI']}
		link={'https://github.com/yureitzk/tboi-flash-save-editor'}
		img={isaacFlashSaveEditorImage}
	/>
	<ProjectCard
		title={'Pinpoint'}
		description={'A simple drawing game to test and train your spatial memory and accuracy.'}
		tags={['TypeScript', 'Canvas', 'Website']}
		link={'https://github.com/yureitzk/pinpoint'}
		img={pinpoint}
	/>
	<ProjectCard
		title={'Human-First Search'}
		description={'A browser extension that filters out AI-generated content from search engines.'}
		tags={['TypeScript', 'Browser Extension', 'Svelte']}
		link={'https://github.com/yureitzk/human-first-search'}
		img={humanFirstSearchImage}
	/>
	<ProjectCard
		title={'Minecraft UUID Username Generator'}
		description={'A Minecraft UUID username generator, designed to work offline as a Progressive Web App.'}
		tags={['JavaScript', 'PWA', 'Website']}
		link={'https://github.com/yureitzk/minecraft-username-uuid-generator'}
		img={minecraftUsernameUuidGenerator}
	/>

</Layout>
